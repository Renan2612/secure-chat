{
  "name": "secure-chat-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "description": "Backend do chat seguro (projeto da disciplina de Redes) — fork saneado de asafebxd/MessageWebApp.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand",
    "test:db": "docker compose -f ../docker-compose.test.yml up -d --wait"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "cookie-session": "^2.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "express-session": "^1.19.0",
    "helmet": "^7.1.0",
    "pg": "^8.11.5",
    "socket.io": "^4.7.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.0",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/env.js"
    ],
    "globalSetup": "<rootDir>/tests/globalSetup.js",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  }
}
