# Copie este arquivo para .env e preencha os valores.
# NUNCA faça commit do .env real — ele já está no .gitignore.

NODE_ENV=development
SERVER_PORT=8000

# URL do frontend: origem aceita pelo CORS da API e pelo upgrade do /ws
# (Origin diferente → 403). Esquema, host e porta precisam bater exatamente.
# Vale para rodar FORA do Docker; no docker compose, o backend recebe
# CLIENT_URL=https://${PUBLIC_HOST} (origem única do proxy, Etapa 4a).
CLIENT_URL=http://localhost:3000

# Opcional, só para o docker compose: nome do site atendido pelo proxy TLS
# (Caddy) e da origem pública. Padrão: localhost.
# PUBLIC_HOST=localhost

# Banco de dados Postgres
DB_USER=postgres
DB_HOST=localhost
DB_NAME=secure_chat
DB_PASSWORD=troque_esta_senha
DB_PORT=5432

# Segredo que assina o ID da sessão no cookie (mínimo 32 caracteres; o
# servidor se recusa a subir sem ele ou com este placeholder). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque_este_segredo

# Opcional — rotação de segredo: ao trocar o SESSION_SECRET, coloque o valor
# antigo aqui por até 8 h (duração da sessão) para não derrubar quem está logado.
# SESSION_SECRET_PREVIOUS=

# Opcional — número de proxies reversos na frente do backend (ex.: 1 com
# nginx). Necessário em produção atrás de proxy HTTPS para o cookie Secure e
# o rate limit por IP funcionarem. NÃO defina sem proxy (permitiria forjar
# X-Forwarded-For).
# TRUST_PROXY=1
