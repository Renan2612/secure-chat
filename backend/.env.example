# Copie este arquivo para .env e preencha os valores.
# NUNCA faça commit do .env real — ele já está no .gitignore.

NODE_ENV=development
SERVER_PORT=8000

# URL do frontend (usada pelo CORS do Express e do Socket.IO)
CLIENT_URL=http://localhost:3000

# Banco de dados Postgres
DB_USER=postgres
DB_HOST=localhost
DB_NAME=secure_chat
DB_PASSWORD=troque_esta_senha
DB_PORT=5432

# Chaves de assinatura do cookie de sessão.
# Gere duas chaves aleatórias distintas, por exemplo com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# A segunda chave existe para permitir ROTAÇÃO sem derrubar sessões ativas
# (no projeto original, as duas eram a mesma variável repetida).
SESSION_KEY_1=troque_esta_chave_1
SESSION_KEY_2=troque_esta_chave_2
