# Proxy reverso e terminador de TLS do secure-chat (Etapa 4a).
# Única origem pública: https://{$PUBLIC_HOST} (padrão: localhost)
#   /       → página estática provisória (proxy/site)
#   /api/*  → backend, SEM o prefixo /api (o Express não conhece /api)
#   /ws     → backend, WebSocket (o caminho é mantido)
# Política e decisões: docs/04-tls-e-proxy.md.
{
	servers {
		# Só HTTP/1.1 e HTTP/2: o compose publica apenas 443/TCP. Com HTTP/3 o
		# Caddy anunciaria (Alt-Svc) um 443/UDP que não existe no host.
		protocols h1 h2
	}
}

# HTTP só redireciona, de forma permanente e preservando o método (308).
http://{$PUBLIC_HOST:localhost} {
	header -Server
	redir https://{host}{uri} 308
}

https://{$PUBLIC_HOST:localhost} {
	# Política TLS explícita (não depende dos padrões do Caddy/Go):
	# - tls internal: certificado emitido pela CA local do Caddy (só
	#   desenvolvimento; em produção, Let's Encrypt; ver docs/04);
	# - TLS 1.2 no mínimo; o 1.3 é negociado sempre que o cliente suportar;
	# - em 1.2, só ECDHE (sigilo futuro) com AEAD (GCM/ChaCha20); sem CBC,
	#   RSA estático, 3DES, RC4. As suítes do TLS 1.3 já são todas AEAD e não
	#   são configuráveis;
	# - curvas: híbrida pós-quântica (X25519MLKEM768), X25519 e P-256/P-384.
	tls internal {
		protocols tls1.2 tls1.3
		ciphers TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
		curves x25519mlkem768 x25519 secp256r1 secp384r1
	}

	# Em todas as respostas da origem. HSTS é emitido SÓ aqui (o helmet do
	# backend está com HSTS desligado). Sem o cabeçalho Server.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Um único caminho para o WebSocket: sem isto, /api/ws chegaria ao
	# backend como /ws (o handle_path tira o prefixo).
	handle /api/ws {
		respond "Não encontrado" 404
	}

	handle_path /api/* {
		# Defesa em profundidade: o Express já recusa corpo > 10 kb.
		request_body {
			max_size 64KB
		}
		# O Caddy SOBRESCREVE X-Forwarded-For/-Proto/-Host com o que ele vê
		# (não confia no que o cliente mandou: trusted_proxies não definido).
		reverse_proxy backend:8000
	}

	handle /ws {
		reverse_proxy backend:8000
	}

	# Página estática provisória (prova de origem única). Cabeçalhos de
	# conteúdo só aqui: as respostas da API já os recebem do helmet.
	handle {
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			Content-Security-Policy "default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		}
		root * /srv
		file_server
	}
}
